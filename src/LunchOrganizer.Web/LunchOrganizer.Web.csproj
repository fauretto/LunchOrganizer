<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LunchOrganizer.Domain\LunchOrganizer.Domain.csproj" />
    <ProjectReference Include="..\LunchOrganizer.Data\LunchOrganizer.Data.csproj" />
    <ProjectReference Include="..\LunchOrganizer.Services\LunchOrganizer.Services.csproj" />
    <ProjectReference Include="..\LunchOrganizer.Email\LunchOrganizer.Email.csproj" />
    <ProjectReference Include="..\LunchOrganizer.Fakes\LunchOrganizer.Fakes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../config/*.json" Exclude="../../config/*.local.json" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Developer-only overrides: copied next to the build output for local runs, but never published -
         a *.local.json reaching a server silently overrides the real config there. -->
    <None Include="../../config/*.local.json" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
